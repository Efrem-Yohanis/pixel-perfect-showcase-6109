# Copy this file to .env before starting Docker Compose.
# Use generated, private values for every password and key before exposing any service.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
DJANGO_DB_PASSWORD=replace-with-a-different-long-random-django-db-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=false
AIRFLOW_SECRET_KEY=replace-with-a-long-random-airflow-secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-long-random-airflow-password
AIRFLOW_UID=50000
